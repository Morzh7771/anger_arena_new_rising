// Усиление суммонов от характеристик хозяина (modifiers/modifier_summon_power.lua).
// Выдаётся всем суммонам героев-игроков (кто суммон - lib/summon_utils.lua).
// Значения пересчитываются раз в update_interval секунд.
"summon_power"
{
	// ЛОВКОСТЬ
	"armor_pct"                 "15"    // + % от брони героя
	"attack_speed_pct"          "15"    // + % от бонусной скорости атаки героя
	"move_speed_per_agi"        "0.5"   // + скорости бега за 1 ловкость
	"armor_pierce_per_agi"      "0.1"   // % игнорирования брони цели за 1 ловкость
	"armor_pierce_max"          "35"    // предел игнорирования брони, %

	// ИНТЕЛЛЕКТ
	"damage_pct"                		"10"    // + % от урона атаки героя
	"damage_per_int"                	"0.2"    // + % от урона атаки героя
	"magic_resist_per_int"               "0.1"    // + % от урона атаки героя
	"magic_resist_max"               	"30"    // + % от урона атаки героя

	// СИЛА
	"health_pct"                "15"    // + % от максимального ХП героя
	"damage_resist_per_str"     "0.05"  // % сопротивления урону за 1 силу
	"damage_resist_max"         "20"    // предел сопротивления урону, %


	"update_interval"           "1"
}
