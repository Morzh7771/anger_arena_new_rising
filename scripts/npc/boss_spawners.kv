	// Боссы с ротацией: каждые rotation_interval секунд от первого спавна
	// пара меняется спотами (канал телепорта 5 с). Пока любого из пары бьют,
	// переход ждёт rotation_quiet секунд без урона; следующий всё равно по
	// сетке 5:00 / 10:00 / 15:00 (lib/boss/boss_spawner.lua, _RotationTick).
	"boss_leoric"
